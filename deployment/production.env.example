# ==============================================================================
# Production Environment Configuration Template
# Automated Image Preprocessing System Using AWS - Module 7
# Target Location on EC2: /var/www/aws-image-preprocessing/.env
# File Permissions: chmod 600 .env (accessible strictly to ec2-user)
# ==============================================================================

# Core Flask Application Settings
FLASK_ENV=production
DEBUG=False
PORT=8000
# Generate secure key on EC2 via: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-key

# Storage Backend Selection ('s3' for production AWS deployment)
STORAGE_BACKEND=s3

# AWS S3 Cloud Storage Configuration (ap-south-1 Mumbai)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=aws-project-2515
S3_PRESIGNED_URL_EXPIRY=3600
S3_OBJECT_PREFIX=uploads/

# AWS IAM Authentication Note:
# In production on AWS EC2, DO NOT populate AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
# Boto3 automatically retrieves temporary rotation credentials via the attached
# EC2 IAM Instance Profile Role ('EC2-S3-ImageProcessing-Role') from IMDSv2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Amazon RDS MySQL Database Configuration (Private VPC Connectivity)
# EC2 and RDS must reside in the same VPC (ap-south-1)
DB_HOST=image-preprocessing-db.cn46oieisfo8.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_rds_database_password_here
DB_NAME=image_preprocessing
DB_CONNECT_TIMEOUT=10

