# ==============================================================================
# Automated Image Preprocessing System Using AWS - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit .env with real secrets to version control)
# 2. Configure your storage backend ('local' or 's3') and AWS settings.
# 3. For AWS authentication, use the standard AWS credential provider chain 
#    (e.g., AWS CLI profile via 'aws configure' or EC2 IAM roles).
# ==============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000

# Storage Selection ('local' or 's3')
STORAGE_BACKEND=local

# AWS S3 Cloud Storage Configuration
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_PRESIGNED_URL_EXPIRY=3600
S3_OBJECT_PREFIX=uploads/

# RDS MySQL Database Configuration (Module 5)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=image_preprocessing
DB_USER=your-database-username
DB_PASSWORD=your-database-password
DB_CONNECT_TIMEOUT=10
