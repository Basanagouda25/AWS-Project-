{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3ImageUploadAndRead",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::aws-project-2515/uploads/*",
        "arn:aws:s3:::aws-project-2515/processed/*"
      ]
    },
    {
      "Sid": "AllowS3BucketInspection",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::aws-project-2515"
      ]
    }
  ]
}

